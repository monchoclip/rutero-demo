# Plantilla del entorno del respaldo. Se copia al servidor como
# /srv/ruts68/secrets/backup.env con dueno postgres y permisos 600.
#
# Es un archivo aparte del de la API porque el respaldo corre como el usuario
# postgres y no necesita ningun secreto de la aplicacion.

DATABASE_URL=
BACKUP_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 1 restaura cada volcado en una base desechable antes de subirlo. Ponerlo en 0
# solo si el disco se queda corto, sabiendo que deja de haber prueba de que el
# respaldo sirve.
RESTORE_CHECK=1
