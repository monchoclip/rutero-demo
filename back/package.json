{
  "name": "@ruts68/back",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "routes:generate": "tsx scripts/routes.ts",
    "routes:check": "tsx scripts/routes.ts --check",
    "reminders": "tsx src/notifications/run.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "fastify": "5.12.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/aws-lambda": "^6.0.0",
    "@aws-sdk/client-sesv2": "^3.600.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
