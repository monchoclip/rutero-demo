[Unit]
Description=Ruts68 - entrega de recordatorios pendientes
After=network-online.target postgresql.service ruts68-api.service
Requires=postgresql.service

[Service]
Type=oneshot
User=ruts68
Group=ruts68
WorkingDirectory=/srv/ruts68/app/back
EnvironmentFile=/srv/ruts68/secrets/api.env
# run.ts procesa la cola una vez y termina. El bloqueo temporal de trabajo y el
# limite de cinco intentos viven en la base, no en este timer, asi que una
# ejecucion que se solape no duplica entregas confirmadas.
ExecStart=/usr/bin/node dist/notifications/run.js

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/srv/ruts68/app/back
