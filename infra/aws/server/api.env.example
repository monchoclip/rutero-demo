# Plantilla del archivo de entorno de la API. Se copia al servidor como
# /srv/ruts68/secrets/api.env con dueno ruts68 y permisos 600. Este archivo de
# ejemplo nunca lleva valores reales y el archivo con valores reales no se
# versiona.
#
# Formato de systemd EnvironmentFile: CLAVE=valor, sin export y sin comillas.

NODE_ENV=production
APP_ORIGIN=https://ruts68.com
PORT=4068
LOG_LEVEL=warn

# Caddy es el unico cliente de este proceso y llega por loopback. Sin esto
# request.ip vale 127.0.0.1 para todos y el limite de quince intentos de ingreso
# pasa a ser una sola cubeta compartida por toda la plataforma.
TRUST_PROXY=loopback

# Copiar el contenido de /srv/ruts68/secrets/database-url, que genero
# cloud-init.sh al crear el rol.
DATABASE_URL=
# Declara que PostgreSQL vive en esta misma maquina. Sin esta linea el preflight
# rechaza una URL de loopback, que es justo lo que usa este diseno.
DATABASE_LOCATION=same-server

MAIL_TRANSPORT=ses
MAIL_FROM=no-reply@ruts68.com
AWS_REGION=us-east-1

# Llave del usuario IAM que crea la pila (salida ServerUserName). Permiso
# limitado a los dos buckets y a un unico remitente de SES.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

VISIT_PHOTO_STORAGE_MODE=s3
VISIT_PHOTO_S3_BUCKET=
VISIT_PHOTO_S3_REGION=us-east-1

# Minimo 32 caracteres con mezcla de tipos. Generar con:
#   head -c 48 /dev/urandom | base64
# Si esta llave se pierde, los tokens de WhatsApp ya guardados no se pueden
# descifrar y hay que volver a registrar cada numero.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Credenciales de terceros. El preflight exige que esten presentes; no inventar
# valores de relleno, porque un secreto falso convierte un modulo roto en un
# modulo que parece configurado.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
