DATABASE_URL=postgresql://ruts68:LOCAL_PASSWORD@127.0.0.1:55468/ruts68
APP_ORIGIN=http://localhost:3068
PORT=4068
NODE_ENV=development
MAIL_TRANSPORT=local
# MAIL_TRANSPORT=ses requires a verified sender, AWS region and runtime IAM permissions.
# MAIL_FROM=recordatorios@ruts68.com
# AWS_REGION=us-east-1
# Symmetric key used to encrypt each WhatsApp number's Meta access token at
# rest. `npm run dev` generates and persists one automatically in
# .local/database.json; set your own random value in every other environment.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# One Meta App's webhook config, shared across every number registered under
# it (per-number identity comes from phoneNumberId, not from these values).
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Optional Wompi Web Checkout. Keep the integrity secret only on the server.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Visit photo storage. Local mode is only for development because it keeps the
# data URL in PostgreSQL for preview and tests. Production must set
# VISIT_PHOTO_STORAGE_MODE=s3 with a private bucket and explicit region.
VISIT_PHOTO_STORAGE_MODE=local
VISIT_PHOTO_MAX_BYTES=2097152
VISIT_PHOTO_RETENTION_DAYS=365
# VISIT_PHOTO_STORAGE_MODE=s3
# VISIT_PHOTO_S3_BUCKET=ruts68-visit-photos
# VISIT_PHOTO_S3_REGION=us-east-1
# VISIT_PHOTO_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# VISIT_PHOTO_S3_FORCE_PATH_STYLE=false
# VISIT_PHOTO_DOWNLOAD_TTL_SECONDS=300
